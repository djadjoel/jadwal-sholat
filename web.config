<?xml version="1.0" encoding="UTF-8"?>
<!--
    Konfigurasi IIS untuk Jadwal Sholat:
    - Menyembunyikan folder backend (src/, storage/) dan berkas non-publik.
    - Header keamanan (CSP ketat, anti-clickjacking, nosniff, dll).
    - Cache statis jangka panjang; index.html & sw.js selalu divalidasi ulang.
-->
<configuration>
    <system.webServer>
        <defaultDocument enabled="true">
            <files>
                <clear />
                <add value="index.html" />
            </files>
        </defaultDocument>
        <directoryBrowse enabled="false" />

        <security>
            <requestFiltering removeServerHeader="true">
                <hiddenSegments>
                    <add segment="src" />
                    <add segment="storage" />
                    <add segment=".git" />
                    <add segment=".gitignore" />
                    <add segment=".claude" />
                    <add segment="README.md" />
                </hiddenSegments>
                <verbs allowUnlisted="false">
                    <add verb="GET" allowed="true" />
                    <add verb="HEAD" allowed="true" />
                </verbs>
                <requestLimits maxQueryString="256" maxUrl="512" />
            </requestFiltering>
        </security>

        <staticContent>
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
        </staticContent>

        <urlCompression doStaticCompression="true" doDynamicCompression="false" />

        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <remove name="Content-Security-Policy" />
                <remove name="X-Content-Type-Options" />
                <remove name="X-Frame-Options" />
                <remove name="Referrer-Policy" />
                <remove name="Permissions-Policy" />
                <remove name="Cross-Origin-Opener-Policy" />
                <remove name="Cross-Origin-Resource-Policy" />
                <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="DENY" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="Permissions-Policy" value="geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()" />
                <add name="Cross-Origin-Opener-Policy" value="same-origin" />
                <add name="Cross-Origin-Resource-Policy" value="same-origin" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>

    <!-- Halaman & service worker harus selalu segar agar pembaruan cepat tersebar. -->
    <location path="index.html">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="sw.js">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="DisableCache" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="manifest.webmanifest">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
